rules_version = '2';

// Phase-3 Storage rules.
//
// Maintenance request photos live under
//   maintenanceRequests/{requestId}/photo_{n}.jpg
// Anyone signed in can read them (the URL is the capability) and any
// signed-in user can upload them, with content-type and size guardrails.
// We can't tighten writes to "the request's tenant" yet because uploads
// happen before the Firestore document is created.
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isImage() {
      return request.resource != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /maintenanceRequests/{requestId}/{file} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isImage();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
